# Copy to .env and set private values. .env is ignored by Git.
# Docker Compose: password of the database container (required by compose.yaml).
SPEC_DB_PASSWORD=change-me
# Native Python: connection to a local PostgreSQL server (scripts/bootstrap_local.py writes these itself).
PGHOST=127.0.0.1
PGPORT=55436
PGUSER=spec_admin
PGPASSWORD=change-me
PGDATABASE=coating_spec
# Sent with the one-off download of the public norm pages; include a contact address.
# NORM_FETCH_USER_AGENT=coating-spec-demo (contact: you@example.org)
